{
  "name": "zpkdx-desktop-agent",
  "private": true,
  "version": "0.1.0-alpha.6.2.3",
  "type": "module",
  "description": "Local-first Minecraft-styled 3D Windows desktop companion prototype",
  "scripts": {
    "dev": "vite --config vite.config.js",
    "dev:web": "vite --config vite.config.js",
    "build:web": "vite build --config vite.config.js",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && node --check web/js/main.js && node --check web/js/engine/renderer.js && npm run build:web",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "skinview3d": "3.4.2",
    "three": "0.156.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^5.4.7"
  },
  "engines": { "node": ">=20" }
}

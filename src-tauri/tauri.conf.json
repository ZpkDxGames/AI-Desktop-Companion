      {"label":"workshop","title":"ZpkDxGames · Avatar Studio","url":"index.html","width":1120,"height":780,"minWidth":840,"minHeight":650,"resizable":true,"visible":false}
    ],
    "security": {"csp":"default-src 'self'; img-src 'self' blob: data:; script-src 'self'; style-src 'self'; connect-src 'self' http://127.0.0.1:4173 ws://127.0.0.1:4173; object-src 'none'"}

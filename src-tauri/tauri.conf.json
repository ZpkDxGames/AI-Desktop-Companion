{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZpkDxGames Desktop Companion",
  "version": "0.1.0-alpha.7.0.0",
  "identifier": "dev.zpkdxgames.desktop-agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm run check",
